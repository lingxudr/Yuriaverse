# Sanka Vollerei Anime API
SANKA_BASE_URL=https://www.sankavollerei.web.id
SANKA_TIMEOUT_MS=8000
SANKA_RETRIES=2

# Optional Redis cache via Upstash REST. Jika kosong, Redis dilewati.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional database cache via Vercel Postgres. Jika kosong, DB cache dilewati.
POSTGRES_URL=

# Cache TTL seconds
CACHE_TTL_SHORT=120
CACHE_TTL_MEDIUM=900
CACHE_TTL_LONG=86400
